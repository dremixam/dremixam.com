---
import BlogArticle from '../../../components/BlogArticle.astro';
import { blogVisible, getAllPosts } from '../../../blog';

export async function getStaticPaths() {
    if (!blogVisible) return [];
    return (await getAllPosts()).map((post) => ({ params: { lang: post.lang, slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
---

<BlogArticle post={post} />
