---
import { blogVisible } from '../../blog';
import { DEFAULT_LANG, LANGS, blogUrl } from '../../i18n';

if (!blogVisible) {
    return Astro.redirect('/');
}

const urls = Object.fromEntries(LANGS.map((lang) => [lang, blogUrl(lang)]));
---

<!doctype html>
<html lang={DEFAULT_LANG}>
    <head>
        <meta charset="utf-8" />
        <meta name="robots" content="noindex" />
        <title>Le blog</title>
        <script is:inline define:vars={{ urls, fallback: DEFAULT_LANG }}>
            const lang = navigator.languages.map((l) => l.slice(0, 2).toLowerCase()).find((l) => l in urls);
            location.replace(urls[lang ?? fallback]);
        </script>
        <noscript><meta http-equiv="refresh" content={`0; url=${blogUrl(DEFAULT_LANG)}`} /></noscript>
    </head>
    <body>
        {LANGS.map((lang) => <p><a href={blogUrl(lang)} hreflang={lang}>{blogUrl(lang)}</a></p>)}
    </body>
</html>
